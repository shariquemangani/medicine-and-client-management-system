{
  "name": "liganexus-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "migrate:flags": "tsx --env-file=.env.local scripts/migrate-flag-categories-to-global.ts",
    "migrate:flags:apply": "tsx --env-file=.env.local scripts/migrate-flag-categories-to-global.ts --apply",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tests/tsconfig.json",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:rules && npm run build",
    "test:e2e": "playwright test",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.539.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.2",
    "react-day-picker": "^9.9.0",
    "react-dom": "19.1.2",
    "react-hook-form": "^7.62.0",
    "react-redux": "^9.2.0",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "firebase-tools": "^15.34.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "3.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "jwks-rsa": "3.2.2",
    "@grpc/grpc-js": "^1.14.6",
    "postcss": "$postcss",
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    }
  }
}
