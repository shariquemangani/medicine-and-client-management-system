# Copy to .env.local for local development (never commit .env.local).
# On Vercel, add every variable below under Project → Settings → Environment Variables.

NODE_ENV=development

# ── Firebase client SDK (public identifiers; safe in the browser) ──────────────
# Firebase console → Project settings → General → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (SECRET, server only) ──────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the private key as ONE line, keeping the literal \n sequences, wrapped in quotes:
# "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Optional: end-to-end tests (use a TEST project only, never production) ───
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
